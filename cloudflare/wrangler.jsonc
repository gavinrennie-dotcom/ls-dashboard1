{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bloqit-ls-live-sync",
  "main": "live-sync-worker.js",
  "compatibility_date": "2026-07-13",
  "secrets": {
    "required": [
      "SLACK_BOT_TOKEN",
      "GOOGLE_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY",
      "SYNC_SECRET"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloqit-ls-live",
      "database_id": "2367f522-8c69-4a7c-86bd-d498ca4ae21a",
      "migrations_dir": "../migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STATUS_POLLER",
        "class_name": "StatusPoller"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-status-poller",
      "new_sqlite_classes": ["StatusPoller"]
    }
  ],
  "vars": {
    "SUPPORT_TIMEZONE": "Europe/Lisbon",
    "LOW_AGENT_THRESHOLD": "3",
    "SLACK_ALERT_CHANNEL_ID": "C0B4D0H0TSR",
    "DASHBOARD_URL": "https://ls-dashboard1.pages.dev",
    "GOOGLE_SHEET_ID": "1Oalb_TLXZmI6jJXGhiBGngUOP-ubzg7OHrOtHFrRyCk",
    "GOOGLE_SHEET_RANGE": "Roster!A1:G100"
  }
}
